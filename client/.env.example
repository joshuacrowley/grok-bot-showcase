# Client Environment Variables
# Copy this file to .env only if you need the escape hatch below.
#
# In the normal deploy the Worker serves this client, so the sync socket is
# same-origin and no configuration is needed. Set VITE_WS_SERVER only when the
# client is hosted somewhere other than the Worker.
#
# Example: grok-bot-roster.your-subdomain.workers.dev
# VITE_WS_SERVER=
